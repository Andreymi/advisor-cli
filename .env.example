# =====================================================
# MCP Advisor - Конфигурация провайдеров
# =====================================================
# Раскомментируйте только те провайдеры, которые хотите использовать.
# Провайдер включён ТОЛЬКО если указан его API ключ.

# ===== Google Gemini =====
# GEMINI_API_KEY=your_key_here

# ===== OpenAI =====
# OPENAI_API_KEY=your_key_here

# ===== DeepSeek =====
# DEEPSEEK_API_KEY=your_key_here

# ===== Anthropic Claude =====
# ANTHROPIC_API_KEY=your_key_here

# ===== Ollama (локальный) =====
# Требует запущенный ollama serve
# OLLAMA_HOST=http://localhost:11434

# ===== Ollama Cloud =====
# Ключ: https://ollama.com → Settings → API Keys
# OLLAMA_API_KEY=your_key_here
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1

# =====================================================
# Модели по умолчанию
# =====================================================
# Примеры:
#   gemini/gemini-2.0-flash
#   openai/gpt-4o-mini
#   deepseek/deepseek-chat
#   ollama-cloud/gpt-oss:120b-cloud
#   ollama/llama3.2

# Модель для consult_expert
# ADVISOR_DEFAULT_MODEL=gemini/gemini-2.0-flash

# Модели для compare_experts (через запятую)
# ADVISOR_DEFAULT_MODELS_COMPARE=gemini/gemini-2.0-flash,openai/gpt-4o-mini

# =====================================================
# Роль эксперта (system prompt)
# =====================================================
# ADVISOR_DEFAULT_ROLE=Ты опытный технический консультант...

# =====================================================
# Настройки сервера
# =====================================================

# Логирование (true для отладки)
ADVISOR_VERBOSE=false

# Кэширование ответов
ADVISOR_CACHE_ENABLED=true
ADVISOR_CACHE_TTL=3600

# Redis (опционально, для production)
# REDIS_URL=redis://localhost:6379
